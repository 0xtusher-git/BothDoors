# The address that gets paid in the demo.
# Leave empty to use the connected wallet as the merchant, so one person can
# test alone. Set it to a real address for the two-wallet demo: open the app in
# one wallet, copy this address, and pay it from a second wallet or from the
# other pay button.
NEXT_PUBLIC_MERCHANT_ADDRESS=

# Which Arc chain the UI starts on: mainnet (default) or testnet.
# The in-app toggle overrides this and remembers your choice.
NEXT_PUBLIC_DEFAULT_CHAIN=mainnet

# Optional. Only needed if you replace the injected connector with RainbowKit /
# WalletConnect. BothDoors v0 uses wagmi's injected connector and needs no
# project id, and there is no backend.
NEXT_PUBLIC_WC_PROJECT_ID=
